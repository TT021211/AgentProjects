<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cuixing.eq.mapper.EqListMapper">
    <resultMap type="com.cuixing.eq.entity.EqList" id="EqListMap">
        <result property="id" column="id" jdbcType="BIGINT"/>
        <result property="equipmentId" column="equipment_id" jdbcType="BIGINT"/>
        <result property="equipmentCode" column="equipment_code" jdbcType="VARCHAR"/>
        <result property="equipmentName" column="equipment_name" jdbcType="VARCHAR"/>
        <result property="equipmentModel" column="equipment_model" jdbcType="VARCHAR"/>
        <result property="planId" column="plan_id" jdbcType="BIGINT"/>
        <result property="planType" column="plan_type" jdbcType="CHAR"/>
        <result property="planCode" column="plan_code" jdbcType="VARCHAR"/>
        <result property="planName" column="plan_name" jdbcType="VARCHAR"/>
        <result property="itemTypeId" column="item_type_id" jdbcType="BIGINT"/>
        <result property="itemTypeName" column="item_type_name" jdbcType="VARCHAR"/>
        <result property="workgroupId" column="workgroup_id" jdbcType="BIGINT"/>
        <result property="workgroupName" column="workgroup_name" jdbcType="VARCHAR"/>
        <result property="headId" column="head_id" jdbcType="BIGINT"/>
        <result property="headName" column="head_name" jdbcType="VARCHAR"/>
        <result property="isDeleted" column="is_deleted" jdbcType="TINYINT"/>
        <result property="version" column="version" jdbcType="INTEGER"/>
        <result property="createBy" column="create_by" jdbcType="VARCHAR"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
        <result property="updateBy" column="update_by" jdbcType="VARCHAR"/>
        <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
        <result property="attr1" column="attr1" jdbcType="VARCHAR"/>
        <result property="attr2" column="attr2" jdbcType="INTEGER"/>
        <result property="attr3" column="attr3" jdbcType="VARCHAR"/>
    </resultMap>
    
    <!-- 通过ID查询单条数据 -->
    <select id="queryById" resultMap="EqListMap">
        select
            id,equipment_id,equipment_code,equipment_name,equipment_model,plan_id,plan_type,plan_code,plan_name,item_type_id,item_type_name,workgroup_id,workgroup_name,head_id,head_name,is_deleted,version,create_by,create_time,update_by,update_time,attr1,attr2,attr3
        from eq_list
        where is_deleted = 0 and  id = #{id}
    </select>

    <select id="getListByPlanType" resultType="int" parameterType="String">
        select count(*) from eq_list where plan_type = #{planType};
    </select>
    
    <!--分页查询指定行数据-->
    <select id="selectEqListList" resultMap="EqListMap">
        select
            id,equipment_id,equipment_code,equipment_name,equipment_model,plan_id,plan_type,plan_code,plan_name,item_type_id,item_type_name,workgroup_id,workgroup_name,head_id,head_name,is_deleted,version,create_by,create_time,update_by,update_time,attr1,attr2,attr3
        from eq_list
        <where>
            is_deleted = 0
            <if test="id != null and id != ''"> and id = #{id}</if>
            <if test="equipmentId != null and equipmentId != ''"> and equipment_id = #{equipmentId}</if>
            <if test="equipmentCode != null and equipmentCode != ''"> and equipment_code = #{equipmentCode}</if>
            <if test="equipmentName != null and equipmentName != ''"> and equipment_name = #{equipmentName}</if>
            <if test="equipmentModel != null and equipmentModel != ''"> and equipment_model = #{equipmentModel}</if>
            <if test="planId != null and planId != ''"> and plan_id = #{planId}</if>
            <if test="planType != null and planType != ''"> and plan_type = #{planType}</if>
            <if test="planCode != null and planCode != ''"> and plan_code = #{planCode}</if>
            <if test="planName != null and planName != ''"> and plan_name = #{planName}</if>
            <if test="itemTypeId != null and itemTypeId != ''"> and item_type_id = #{itemTypeId}</if>
            <if test="itemTypeName != null and itemTypeName != ''"> and item_type_name = #{itemTypeName}</if>
            <if test="workgroupId != null and workgroupId != ''"> and workgroup_id = #{workgroupId}</if>
            <if test="workgroupName != null and workgroupName != ''"> and workgroup_name = #{workgroupName}</if>
            <if test="headId != null and headId != ''"> and head_id = #{headId}</if>
            <if test="headName != null and headName != ''"> and head_name = #{headName}</if>
            <if test="isDeleted != null and isDeleted != ''"> and is_deleted = #{isDeleted}</if>
            <if test="version != null and version != ''"> and version = #{version}</if>
            <if test="createBy != null and createBy != ''"> and create_by = #{createBy}</if>
            <if test="createTime != null and createTime != ''"> and create_time = #{createTime}</if>
            <if test="updateBy != null and updateBy != ''"> and update_by = #{updateBy}</if>
            <if test="updateTime != null and updateTime != ''"> and update_time = #{updateTime}</if>
            <if test="attr1 != null and attr1 != ''"> and attr1 = #{attr1}</if>
            <if test="attr2 != null and attr2 != ''"> and attr2 = #{attr2}</if>
            <if test="attr3 != null and attr3 != ''"> and attr3 = #{attr3}</if>
        </where>
        order by equipment_code asc
    </select>
    
    <!--新增数据-->
    <insert id="insert" keyProperty="id" useGeneratedKeys="true">
        insert into eq_list
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null ">id,</if>
            <if test="equipmentId != null ">equipment_id,</if>
            <if test="equipmentCode != null and equipmentCode != ''">equipment_code,</if>
            <if test="equipmentName != null and equipmentName != ''">equipment_name,</if>
            <if test="equipmentModel != null and equipmentModel != ''">equipment_model,</if>
            <if test="planId != null ">plan_id,</if>
            <if test="planType != null and planType != ''">plan_type,</if>
            <if test="planCode != null and planCode != ''">plan_code,</if>
            <if test="planName != null and planName != ''">plan_name,</if>
            <if test="itemTypeId != null ">item_type_id,</if>
            <if test="itemTypeName != null and itemTypeName != ''">item_type_name,</if>
            <if test="workgroupId != null ">workgroup_id,</if>
            <if test="workgroupName != null and workgroupName != ''">workgroup_name,</if>
            <if test="headId != null ">head_id,</if>
            <if test="headName != null and headName != ''">head_name,</if>
            <if test="isDeleted != null ">is_deleted,</if>
            <if test="version != null ">version,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="createTime != null ">create_time,</if>
            <if test="updateBy != null and updateBy != ''">update_by,</if>
            <if test="updateTime != null ">update_time,</if>
            <if test="attr1 != null and attr1 != ''">attr1,</if>
            <if test="attr2 != null ">attr2,</if>
            <if test="attr3 != null and attr3 != ''">attr3,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="equipmentId != null">#{equipmentId},</if>
            <if test="equipmentCode != null and equipmentCode != ''">#{equipmentCode},</if>
            <if test="equipmentName != null and equipmentName != ''">#{equipmentName},</if>
            <if test="equipmentModel != null and equipmentModel != ''">#{equipmentModel},</if>
            <if test="planId != null">#{planId},</if>
            <if test="planType != null and planType != ''">#{planType},</if>
            <if test="planCode != null and planCode != ''">#{planCode},</if>
            <if test="planName != null and planName != ''">#{planName},</if>
            <if test="itemTypeId != null">#{itemTypeId},</if>
            <if test="itemTypeName != null and itemTypeName != ''">#{itemTypeName},</if>
            <if test="workgroupId != null">#{workgroupId},</if>
            <if test="workgroupName != null and workgroupName != ''">#{workgroupName},</if>
            <if test="headId != null">#{headId},</if>
            <if test="headName != null and headName != ''">#{headName},</if>
            <if test="isDeleted != null">#{isDeleted},</if>
            <if test="version != null">#{version},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null and updateBy != ''">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="attr1 != null and attr1 != ''">#{attr1},</if>
            <if test="attr2 != null">#{attr2},</if>
            <if test="attr3 != null and attr3 != ''">#{attr3},</if>
        </trim>
    </insert>
    
    <!-- 更新数据 -->
    <update id="update">
        update eq_list
        <set>
            <trim suffixOverrides=",">
                <if test="equipmentId != null "> equipment_id = #{equipmentId}, </if>
                <if test="equipmentCode != null "> equipment_code = #{equipmentCode}, </if>
                <if test="equipmentName != null "> equipment_name = #{equipmentName}, </if>
                <if test="equipmentModel != null "> equipment_model = #{equipmentModel}, </if>
                <if test="planId != null "> plan_id = #{planId}, </if>
                <if test="planType != null "> plan_type = #{planType}, </if>
                <if test="planCode != null "> plan_code = #{planCode}, </if>
                <if test="planName != null "> plan_name = #{planName}, </if>
                <if test="itemTypeId != null "> item_type_id = #{itemTypeId}, </if>
                <if test="itemTypeName != null "> item_type_name = #{itemTypeName}, </if>
                <if test="workgroupId != null "> workgroup_id = #{workgroupId}, </if>
                <if test="workgroupName != null "> workgroup_name = #{workgroupName}, </if>
                <if test="headId != null "> head_id = #{headId}, </if>
                <if test="headName != null "> head_name = #{headName}, </if>
                <if test="isDeleted != null "> is_deleted = #{isDeleted}, </if>
                <if test="version != null "> version = #{version}, </if>
                <if test="createBy != null "> create_by = #{createBy}, </if>
                <if test="createTime != null "> create_time = #{createTime}, </if>
                <if test="updateBy != null "> update_by = #{updateBy}, </if>
                <if test="updateTime != null "> update_time = #{updateTime}, </if>
                <if test="attr1 != null "> attr1 = #{attr1}, </if>
                <if test="attr2 != null "> attr2 = #{attr2}, </if>
                <if test="attr3 != null "> attr3 = #{attr3}, </if>
            </trim>
        </set>
        where id = #{id} and version = #{version}
    </update>
    
    <!--逻辑删除删除-->
    <delete id="deleteById">
        delete from eq_list  where id = #{id}
    </delete>
    
    <!--批量逻辑删除-->
    <delete id="deleteByIds">
        delete from eq_list where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>