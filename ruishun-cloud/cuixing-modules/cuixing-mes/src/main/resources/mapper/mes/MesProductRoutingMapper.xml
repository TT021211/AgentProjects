    <!-- 批量新增或按主键更新数据 -->
    <insert id="insertOrUpdateBatch" keyProperty="id" useGeneratedKeys="true">
        insert into mes_product_routing(id,product_id,product_name,product_code,routing_id,routing_name,is_default,version,is_deleted,create_by,create_time,update_by,update_time,attr1,attr2,attr3)
        values
        <foreach collection="entities" item="entity" separator=",">
            (#{entity.id},#{entity.productId},#{entity.productName},#{entity.productCode},#{entity.routingId},#{entity.routingName},#{entity.isDefault},#{entity.version},#{entity.isDeleted},#{entity.createBy},#{entity.createTime},#{entity.updateBy},#{entity.updateTime},#{entity.attr1},#{entity.attr2},#{entity.attr3})
        </foreach>
        on duplicate key update
        id=values(id),
        product_id=values(product_id),
        product_name=values(product_name),
        product_code=values(product_code),
        routing_id=values(routing_id),
        routing_name=values(routing_name),
        is_default=values(is_default),
        version=values(version),
        is_deleted=values(is_deleted),
        create_by=values(create_by),
        create_time=values(create_time),
        update_by=values(update_by),
        update_time=values(update_time),
        attr1=values(attr1),
        attr2=values(attr2),
        attr3=values(attr3)
    </insert>

    <!-- 更新数据 -->
    <update id="update">
        update mes_product_routing
        <set>
            <trim suffixOverrides=",">
                <if test="productId != null">
                    product_id = #{productId},
                </if>
                <if test="productName != null">
                    product_name = #{productName},
                </if>
                <if test="productCode != null">
