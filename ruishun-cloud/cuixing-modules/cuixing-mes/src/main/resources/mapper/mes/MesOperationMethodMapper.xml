            <if test="attr2 != null ">attr2,</if>
            <if test="attr3 != null and attr3 != ''">attr3,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="operationType != null and operationType != ''">#{operationType},</if>
            <if test="operationName != null and operationName != ''">#{operationName},</if>
            <if test="operationCode != null and operationCode != ''">#{operationCode},</if>
            <if test="enanellingWorkbenchId != null">#{enanellingWorkbenchId},</if>
            <if test="enanellingWorkbenchName != null and enanellingWorkbenchName != ''">#{enanellingWorkbenchName},</if>
            <if test="ableTime != null">#{ableTime},</if>
            <if test="image != null and image != ''">#{image},</if>
