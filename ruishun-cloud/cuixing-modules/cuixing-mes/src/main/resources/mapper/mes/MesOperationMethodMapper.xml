            </trim>
        </set>
        where id = #{id}
    </update>
    
    <!--逻辑删除删除-->
    <update id="deleteById">
        update mes_operation_method set is_deleted = 1 where id = #{id}
    </update>
    
    <!--批量逻辑删除-->
    <update id="deleteByIds">
        update mes_operation_method set is_deleted = 1 where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>
</mapper>