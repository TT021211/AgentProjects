        <result property="attr3" column="attr3" jdbcType="VARCHAR"/>
    </resultMap>
    
    <!-- 通过ID查询单条数据 -->
    <select id="queryById" resultMap="MesOperationMethodMap">
        select
            id,operation_type,operation_name,operation_code,enanelling_workbench_id,enanelling_workbench_name,able_time,image,file_path,is_deleted,version,create_by,create_time,update_by,update_time,attr1,attr2,attr3
        from mes_operation_method
        where is_deleted = 0 and  id = #{id}
    </select>

    <!-- 通过机台ID查询列表 -->
    <select id="getByEnanellingWorkbenchId" resultMap="MesOperationMethodMap">
        select
            id,operation_type,operation_name,operation_code,enanelling_workbench_id,enanelling_workbench_name,able_time,image,file_path,is_deleted,version,create_by,create_time,update_by,update_time,attr1,attr2,attr3
        from mes_operation_method
        where is_deleted = 0 and  enanelling_workbench_id = #{enanellingWorkbenchId} and operation_type = #{operationType}
    </select>
    
    <!--分页查询指定行数据-->
    <select id="selectMesOperationMethodList" resultMap="MesOperationMethodMap">
