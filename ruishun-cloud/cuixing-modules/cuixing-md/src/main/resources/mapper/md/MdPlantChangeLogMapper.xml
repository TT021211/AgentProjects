        from md_plant_change_log
        <where>
            is_deleted = 0
            <if test="id != null and id != ''"> and id = #{id}</if>
            <if test="plantCode != null and plantCode != ''"> and plant_code like concat('%', #{plantCode},'%')</if>
            <if test="plantName != null and plantName != ''"> and plant_name like concat('%', #{plantName},'%')</if>
            <if test="plantType != null and plantType != ''"> and plant_type like concat('%', #{plantType},'%')</if>
            <if test="weight != null and weight != ''"> and weight = #{weight}</if>
            <if test="measureId != null and measureId != ''"> and measure_id = #{measureId}</if>
