    <!-- 通过ID查询单条数据 -->
    <select id="queryById" resultMap="MdPlantChangeLogMap">
        select
            id,plant_code,plant_name,plant_type,weight,measure_id,measure_name,workbench_id,workbench_code,out_create_by,out_job_number,out_time,change_workbench,is_deleted,version,job_number,create_by,create_time,update_by,update_time,attr1,attr2,attr3
        from md_plant_change_log
        where is_deleted = 0 and  id = #{id}
    </select>
    
    <!--分页查询指定行数据-->
    <select id="selectMdPlantChangeLogList" resultMap="MdPlantChangeLogMap">
