    <!-- 通过ID查询单条数据 -->
    <select id="queryById" resultMap="MdWorkgroupMemberMap">
        select
        id,workgroup_id,workgroup_code,workgroup_name,member_id,member_name,version,is_deleted,create_by,create_time,update_by,update_time,attr1,attr2,attr3
        from md_workgroup_member
        where is_deleted = 0 and id = #{id}
    </select>

