        id,measure_code,measure_name,if_primary,primary_id,change_rate,if_enable,remark,attr1,attr2,attr3,is_deleted,version,create_by,create_time,update_by,update_time
        from md_unit_measure
        where is_deleted = 0 and id = #{id}
    </select>

