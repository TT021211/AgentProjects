    <!-- 批量新增或按主键更新数据 -->
    <insert id="insertOrUpdateBatch" keyProperty="id" useGeneratedKeys="true">
        insert into md_workshop(id,workshop_code,workshop_name,area,head,if_enable,remark,attr1,attr2,attr3,version,is_deleted,create_by,create_time,update_by,update_time)
        values
        <foreach collection="entities" item="entity" separator=",">
            (#{entity.id},#{entity.workshopCode},#{entity.workshopName},#{entity.area},#{entity.head},#{entity.ifEnable},#{entity.remark},#{entity.attr1},#{entity.attr2},#{entity.attr3},#{entity.version},#{entity.isDeleted},#{entity.createBy},#{entity.createTime},#{entity.updateBy},#{entity.updateTime})
        </foreach>
        on duplicate key update
        id=values(id),
        workshop_code=values(workshop_code),
        workshop_name=values(workshop_name),
        area=values(area),
        head=values(head),
        if_enable=values(if_enable),
        remark=values(remark),
        attr1=values(attr1),
        attr2=values(attr2),
        attr3=values(attr3),
        version=values(version),
        is_deleted=values(is_deleted),
        create_by=values(create_by),
        create_time=values(create_time),
        update_by=values(update_by),
        update_time=values(update_time)
    </insert>

    <!-- 更新数据 -->
    <update id="update">
        update md_workshop
        <set>
            <trim suffixOverrides=",">
                <if test="workshopCode != null">
                    workshop_code = #{workshopCode},
                </if>
                <if test="workshopName != null">
                    workshop_name = #{workshopName},
                </if>
                <if test="area != null">
                    area = #{area},
                </if>
                <if test="head != null">
                    head = #{head},
                </if>
                <if test="ifEnable != null">
                    if_enable = #{ifEnable},
                </if>
                <if test="remark != null">
                    remark = #{remark},
                </if>
                <if test="attr1 != null">
                    attr1 = #{attr1},
                </if>
                <if test="attr2 != null">
                    attr2 = #{attr2},
                </if>
                <if test="attr3 != null">
                    attr3 = #{attr3},
                </if>
                <if test="version != null">
                    version = #{version}+1,
                </if>
                <if test="isDeleted != null">
                    is_deleted = #{isDeleted},
                </if>
                <if test="createBy != null">
                    create_by = #{createBy},
                </if>
                <if test="createTime != null">
                    create_time = #{createTime},
                </if>
                <if test="updateBy != null">
                    update_by = #{updateBy},
                </if>
                <if test="updateTime != null">
                    update_time = #{updateTime},
                </if>
            </trim>
        </set>
        where id = #{id} and version = #{version}
    </update>

    <!--逻辑删除-->
    <update id="deleteById">
        update md_workshop set is_deleted = 1 where id = #{id}
    </update>

    <!--批量逻辑删除-->
    <update id="deleteByIds">
        update md_workshop set is_deleted = 1 where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <!--物理删除-->
    <delete id="removeById">
        delete from md_workshop where id = #{id}
    </delete>
</mapper>