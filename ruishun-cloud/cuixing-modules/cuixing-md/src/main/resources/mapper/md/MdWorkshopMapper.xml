<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cuixing.md.mapper.MdWorkshopMapper">
    <resultMap type="com.cuixing.md.entity.MdWorkshop" id="MdWorkshopMap">
        <result property="id" column="id" jdbcType="BIGINT"/>
        <result property="workshopCode" column="workshop_code" jdbcType="VARCHAR"/>
        <result property="workshopName" column="workshop_name" jdbcType="VARCHAR"/>
        <result property="area" column="area" jdbcType="DECIMAL"/>
        <result property="head" column="head" jdbcType="VARCHAR"/>
        <result property="ifEnable" column="if_enable" jdbcType="INTEGER"/>
        <result property="remark" column="remark" jdbcType="VARCHAR"/>
        <result property="attr1" column="attr1" jdbcType="VARCHAR"/>
        <result property="attr2" column="attr2" jdbcType="INTEGER"/>
        <result property="attr3" column="attr3" jdbcType="VARCHAR"/>
        <result property="version" column="version" jdbcType="INTEGER"/>
        <result property="isDeleted" column="is_deleted" jdbcType="INTEGER"/>
        <result property="createBy" column="create_by" jdbcType="VARCHAR"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
        <result property="updateBy" column="update_by" jdbcType="VARCHAR"/>
        <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
    </resultMap>

    <!-- 通过ID查询单条数据 -->
    <select id="queryById" resultMap="MdWorkshopMap">
        select
        id,workshop_code,workshop_name,area,head,if_enable,remark,attr1,attr2,attr3,version,is_deleted,create_by,create_time,update_by,update_time
        from md_workshop
        where is_deleted = 0 and id = #{id}
    </select>

    <!--分页查询指定行数据-->
    <select id="selectMdWorkshopList" resultMap="MdWorkshopMap" parameterType="MdWorkshop">
        select
        d.id,d.workshop_code,d.workshop_name,d.area,d.head,d.if_enable,d.remark,d.attr1,d.attr2,d.attr3,d.version,d.is_deleted,d.create_by,d.create_time,d.update_by,d.update_time
        from md_workshop d
        <where>
            is_deleted = 0
            <if test="id != null ">
                and id = #{id}
            </if>
            <if test="workshopCode != null and workshopCode != ''">
                and workshop_code = #{workshopCode}
            </if>
            <if test="workshopName != null and workshopName != ''">
                and workshop_name = #{workshopName}
            </if>
            <if test="area != null ">
                and area = #{area}
            </if>
            <if test="head != null and head != ''">
                and head = #{head}
            </if>
            <if test="ifEnable != null ">
                and if_enable = #{ifEnable}
            </if>
            <if test="remark != null and remark != ''">
                and remark = #{remark}
            </if>
            <if test="attr1 != null and attr1 != ''">
                and attr1 = #{attr1}
            </if>
            <if test="attr2 != null ">
                and attr2 = #{attr2}
            </if>
            <if test="attr3 != null and attr3 != ''">
                and attr3 = #{attr3}
            </if>
            <if test="version != null ">
                and version = #{version}
            </if>
            <if test="isDeleted != null ">
                and is_deleted = #{isDeleted}
            </if>
            <if test="createBy != null and createBy != ''">
                and create_by = #{createBy}
            </if>
            <if test="createTime != null ">
                and create_time = #{createTime}
            </if>
            <if test="updateBy != null and updateBy != ''">
                and update_by = #{updateBy}
            </if>
            <if test="updateTime != null ">
                and update_time = #{updateTime}
            </if>
        </where>
        order by create_time desc
    </select>

    <!--统计总行数-->
    <select id="count" resultType="java.lang.Long">
        select count(1)
        from md_workshop
        <where>
            is_deleted = 0
            <if test="id != null ">
                and id = #{id}
            </if>
            <if test="workshopCode != null and workshopCode != ''">
                and workshop_code = #{workshopCode}
            </if>
            <if test="workshopName != null and workshopName != ''">
                and workshop_name = #{workshopName}
            </if>
            <if test="area != null ">
                and area = #{area}
            </if>
            <if test="head != null and head != ''">
                and head = #{head}
            </if>
            <if test="ifEnable != null ">
                and if_enable = #{ifEnable}
            </if>
            <if test="remark != null and remark != ''">
                and remark = #{remark}
            </if>
            <if test="attr1 != null and attr1 != ''">
                and attr1 = #{attr1}
            </if>
            <if test="attr2 != null ">
                and attr2 = #{attr2}
            </if>
            <if test="attr3 != null and attr3 != ''">
                and attr3 = #{attr3}
            </if>
            <if test="version != null ">
                and version = #{version}
            </if>
            <if test="isDeleted != null ">
                and is_deleted = #{isDeleted}
            </if>
            <if test="createBy != null and createBy != ''">
                and create_by = #{createBy}
            </if>
            <if test="createTime != null ">
                and create_time = #{createTime}
            </if>
            <if test="updateBy != null and updateBy != ''">
                and update_by = #{updateBy}
            </if>
            <if test="updateTime != null ">
                and update_time = #{updateTime}
            </if>
        </where>
    </select>

