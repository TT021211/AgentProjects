    <!-- 通过ID查询单条数据 -->
    <select id="queryById" resultMap="MdItemTypeMap">
        select
        id,item_type_code,item_type_name,parent_type_id,ancestors,order_num,if_enable,remark,attr1,attr2,attr3,is_deleted,version,create_by,create_time,update_by,update_time
        from md_item_type
        where is_deleted = 0 and id = #{id}
    </select>

    <!--分页查询指定行数据-->
    <select id="selectMdItemTypeList" resultMap="MdItemTypeMap" parameterType="MdItemType">
        select
        d.id,d.item_type_code,d.item_type_name,d.parent_type_id,d.ancestors,d.order_num,d.if_enable,d.remark,d.attr1,d.attr2,d.attr3,d.is_deleted,d.version,d.create_by,d.create_time,d.update_by,d.update_time
        from md_item_type d
        <where>
            is_deleted = 0
            <if test="id != null ">
                and id = #{id}
            </if>
            <if test="itemTypeCode != null and itemTypeCode != ''">
                and item_type_code = #{itemTypeCode}
            </if>
            <if test="itemTypeName != null and itemTypeName != ''">
                and item_type_name = #{itemTypeName}
            </if>
            <if test="parentTypeId != null ">
                and parent_type_id = #{parentTypeId}
            </if>
            <if test="ancestors != null and ancestors != ''">
                and ancestors = #{ancestors}
            </if>
            <if test="orderNum != null ">
                and order_num = #{orderNum}
            </if>
            <if test="ifEnable != null ">
                and if_enable = #{ifEnable}
            </if>
            <if test="remark != null and remark != ''">
                and remark = #{remark}
            </if>
            <if test="attr1 != null and attr1 != ''">
                and attr1 = #{attr1}
            </if>
            <if test="attr2 != null ">
                and attr2 = #{attr2}
            </if>
            <if test="attr3 != null and attr3 != ''">
                and attr3 = #{attr3}
            </if>
            <if test="isDeleted != null ">
                and is_deleted = #{isDeleted}
            </if>
            <if test="version != null ">
                and version = #{version}
            </if>
            <if test="createBy != null and createBy != ''">
                and create_by = #{createBy}
            </if>
            <if test="createTime != null ">
                and create_time = #{createTime}
            </if>
            <if test="updateBy != null and updateBy != ''">
                and update_by = #{updateBy}
            </if>
            <if test="updateTime != null ">
                and update_time = #{updateTime}
            </if>
        </where>
        order by order_num asc, create_time desc
    </select>

