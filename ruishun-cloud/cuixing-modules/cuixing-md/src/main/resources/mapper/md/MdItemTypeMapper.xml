    <!-- 批量新增或按主键更新数据 -->
    <insert id="insertOrUpdateBatch" keyProperty="id" useGeneratedKeys="true">
        insert into md_item_type(id,item_type_code,item_type_name,parent_type_id,ancestors,order_num,if_enable,remark,attr1,attr2,attr3,is_deleted,version,create_by,create_time,update_by,update_time)
        values
        <foreach collection="entities" item="entity" separator=",">
            (#{entity.id},#{entity.itemTypeCode},#{entity.itemTypeName},#{entity.parentTypeId},#{entity.ancestors},#{entity.orderNum},#{entity.ifEnable},#{entity.remark},#{entity.attr1},#{entity.attr2},#{entity.attr3},#{entity.isDeleted},#{entity.version},#{entity.createBy},#{entity.createTime},#{entity.updateBy},#{entity.updateTime})
        </foreach>
        on duplicate key update
        id=values(id),
        item_type_code=values(item_type_code),
        item_type_name=values(item_type_name),
        parent_type_id=values(parent_type_id),
        ancestors=values(ancestors),
        order_num=values(order_num),
        if_enable=values(if_enable),
        remark=values(remark),
        attr1=values(attr1),
        attr2=values(attr2),
        attr3=values(attr3),
        is_deleted=values(is_deleted),
        version=values(version),
        create_by=values(create_by),
        create_time=values(create_time),
        update_by=values(update_by),
        update_time=values(update_time)
    </insert>

    <!-- 更新数据 -->
    <update id="update">
        update md_item_type
        <set>
            <trim suffixOverrides=",">
                <if test="itemTypeCode != null">
                    item_type_code = #{itemTypeCode},
                </if>
                <if test="itemTypeName != null">
                    item_type_name = #{itemTypeName},
                </if>
                <if test="parentTypeId != null">
                    parent_type_id = #{parentTypeId},
                </if>
                <if test="ancestors != null">
                    ancestors = #{ancestors},
                </if>
                <if test="orderNum != null">
                    order_num = #{orderNum},
                </if>
                <if test="ifEnable != null">
                    if_enable = #{ifEnable},
                </if>
                <if test="remark != null">
                    remark = #{remark},
                </if>
                <if test="attr1 != null">
                    attr1 = #{attr1},
                </if>
                <if test="attr2 != null">
                    attr2 = #{attr2},
                </if>
                <if test="attr3 != null">
                    attr3 = #{attr3},
                </if>
                <if test="isDeleted != null">
                    is_deleted = #{isDeleted},
                </if>
                <if test="version != null">
                    version = #{version}+1,
                </if>
                <if test="createBy != null">
                    create_by = #{createBy},
                </if>
                <if test="createTime != null">
                    create_time = #{createTime},
                </if>
                <if test="updateBy != null">
                    update_by = #{updateBy},
                </if>
                <if test="updateTime != null">
                    update_time = #{updateTime},
                </if>
            </trim>
        </set>
        where id = #{id} and version = #{version}
    </update>

    <!--逻辑删除-->
    <update id="deleteById">
        update md_item_type set is_deleted = 1 where id = #{id}
    </update>

    <!--批量逻辑删除-->
    <update id="deleteByIds">
        update md_item_type set is_deleted = 1 where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <!--物理删除-->
    <delete id="removeById">
        delete from md_item_type where id = #{id}
    </delete>
</mapper>