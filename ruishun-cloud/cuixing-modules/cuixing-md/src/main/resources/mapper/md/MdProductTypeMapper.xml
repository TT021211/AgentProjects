    <!-- 批量新增或按主键更新数据 -->
    <insert id="insertOrUpdateBatch" keyProperty="id" useGeneratedKeys="true">
        insert into md_product_type(id,type_name,type_code,parent_type_id,ancestors,if_enable,version,is_deleted,create_by,create_time,update_by,update_time,attr1,attr2,attr3)
        values
        <foreach collection="entities" item="entity" separator=",">
            (#{entity.id},#{entity.typeName},#{entity.typeCode},#{entity.parentTypeId},#{entity.ancestors},#{entity.ifEnable},#{entity.version},#{entity.isDeleted},#{entity.createBy},#{entity.createTime},#{entity.updateBy},#{entity.updateTime},#{entity.attr1},#{entity.attr2},#{entity.attr3})
        </foreach>
        on duplicate key update
        id=values(id),
        type_name=values(type_name),
        type_code=values(type_code),
        parent_type_id=values(parent_type_id),
        ancestors=values(ancestors),
        if_enable=values(if_enable),
        version=values(version),
        is_deleted=values(is_deleted),
        create_by=values(create_by),
        create_time=values(create_time),
        update_by=values(update_by),
        update_time=values(update_time),
        attr1=values(attr1),
        attr2=values(attr2),
        attr3=values(attr3)
    </insert>

    <!-- 更新数据 -->
    <update id="update">
        update md_product_type
        <set>
            <trim suffixOverrides=",">
                <if test="typeName != null">
                    type_name = #{typeName},
                </if>
                <if test="typeCode != null">
                    type_code = #{typeCode},
                </if>
                <if test="parentTypeId != null">
                    parent_type_id = #{parentTypeId},
                </if>
                <if test="ancestors != null">
                    ancestors = #{ancestors},
                </if>
                <if test="ifEnable != null">
                    if_enable = #{ifEnable},
                </if>
                <if test="version != null">
                    version = #{version}+1,
                </if>
                <if test="isDeleted != null">
                    is_deleted = #{isDeleted},
                </if>
                <if test="createBy != null">
                    create_by = #{createBy},
                </if>
                <if test="createTime != null">
                    create_time = #{createTime},
                </if>
                <if test="updateBy != null">
                    update_by = #{updateBy},
                </if>
                <if test="updateTime != null">
                    update_time = #{updateTime},
                </if>
                <if test="attr1 != null">
                    attr1 = #{attr1},
                </if>
                <if test="attr2 != null">
                    attr2 = #{attr2},
                </if>
                <if test="attr3 != null">
                    attr3 = #{attr3},
                </if>
            </trim>
        </set>
        where id = #{id} and version = #{version}
    </update>

    <!--逻辑删除-->
    <update id="deleteById">
        update md_product_type set is_deleted = 1 where id = #{id}
    </update>

    <!--批量逻辑删除-->
    <update id="deleteByIds">
        update md_product_type set is_deleted = 1 where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <!--物理删除-->
    <delete id="removeById">
        delete from md_product_type where id = #{id}
    </delete>
</mapper>
