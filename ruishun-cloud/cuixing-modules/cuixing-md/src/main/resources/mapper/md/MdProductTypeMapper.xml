            </if>
        </where>
    </select>
    <select id="queryByTypeName" resultMap="MdProductTypeMap">
        select
            id,type_name,type_code,parent_type_id,ancestors,if_enable,version,is_deleted,create_by,create_time,update_by,update_time,attr1,attr2,attr3
        from md_product_type
        where is_deleted = 0 and type_name = #{name}
    </select>

