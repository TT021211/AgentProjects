"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cuixing.ecm.mapper.EcmElectricDeviceMapper">
    
    <resultMap type="com.cuixing.ecm.domain.EcmElectricDevice" id="EcmElectricDeviceResult">
        <result property="electricDeviceId"    column="electric_device_id"    />
        <result property="electricDeviceName"    column="electric_device_name"    />
        <result property="electricDeviceCode"    column="electric_device_code"    />
        <result property="model"    column="model"    />
        <result property="manufacturer"    column="manufacturer"    />
        <result property="installationDate"    column="installation_date"    />
        <result property="location"    column="location"    />
        <result property="status"    column="status"    />
        <result property="version"    column="version"    />
        <result property="isDeleted"    column="is_deleted"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
        <result property="attr1"    column="attr1"    />
        <result property="attr2"    column="attr2"    />
        <result property="attr3"    column="attr3"    />
        <result property="isMain"    column="is_main"    />
        <result property="parentId"    column="parent_id"    />
        <result property="parentName"    column="parentName"    />
    </resultMap>

    <sql id="selectEcmElectricDeviceVo">
        select t1.*, t2.electric_device_name as parentName from ecm_electric_device t1 LEFT JOIN ecm_electric_device t2 ON t1.parent_id = t2.electric_device_id
    </sql>

    <select id="selectEcmElectricDeviceList" parameterType="EcmElectricDevice" resultMap="EcmElectricDeviceResult">
        <include refid="selectEcmElectricDeviceVo"/>
        <where>
            <if test="electricDeviceCode != null  and electricDeviceCode != ''"> and t1.electric_device_code = #{electricDeviceCode}</if>
            <if test="electricDeviceName != null  and electricDeviceName != ''"> and t1.electric_device_name = #{electricDeviceName}</if>
            <if test="model != null  and model != ''"> and t1.model = #{model}</if>
            <if test="manufacturer != null  and manufacturer != ''"> and t1.manufacturer = #{manufacturer}</if>
            <if test="installationDate != null "> and t1.installation_date = #{installationDate}</if>
            <if test="location != null  and location != ''"> and t1.location = #{location}</if>
            <if test="status != null  and status != ''"> and t1.status = #{status}</if>
            <if test="version != null "> and t1.version = #{version}</if>
            <if test="isDeleted != null "> and t1.is_deleted = #{isDeleted}</if>
            <if test="attr1 != null  and attr1 != ''"> and t1.attr1 = #{attr1}</if>
            <if test="attr2 != null "> and t1.attr2 = #{attr2}</if>
            <if test="attr3 != null  and attr3 != ''"> and t1.attr3 = #{attr3}</if>
            <if test="isMain != null  and isMain != ''"> and t1.is_main = #{isMain}</if>
            <if test="parentId != null "> and t1.parent_id = #{parentId}</if>
        </where>
        order by is_main desc,location,electric_device_name asc
    </select>
    
    <select id="selectEcmElectricDeviceByElectricDeviceId" parameterType="Long" resultMap="EcmElectricDeviceResult">
        <include refid="selectEcmElectricDeviceVo"/>
        where t1.electric_device_id = #{electricDeviceId}
    </select>

    <select id="getDeviceListByLocation" parameterType="String" resultMap="EcmElectricDeviceResult">
        <include refid="selectEcmElectricDeviceVo"/>
        where t1.location = #{location}
        order by electric_device_name asc
    </select>

    <select id="getDeviceListByParentId" parameterType="int" resultMap="EcmElectricDeviceResult">
        <include refid="selectEcmElectricDeviceVo"/>
        where t1.parent_id = #{parentId}
    </select>

    <select id="getDeviceListByElectricDeviceCode" parameterType="String" resultMap="EcmElectricDeviceResult">
        <include refid="selectEcmElectricDeviceVo"/>
        where t1.electric_device_code = #{electricDeviceCode}
    </select>
        
    <insert id="insertEcmElectricDevice" parameterType="EcmElectricDevice" useGeneratedKeys="true" keyProperty="electricDeviceId">
        insert into ecm_electric_device
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="electricDeviceId != null">electric_device_id,</if>
            <if test="electricDeviceName != null">electric_device_name,</if>
            <if test="electricDeviceCode != null and electricDeviceCode != ''">electric_device_code,</if>
            <if test="model != null">model,</if>
            <if test="manufacturer != null">manufacturer,</if>
            <if test="installationDate != null">installation_date,</if>
            <if test="location != null">location,</if>
            <if test="status != null">status,</if>
