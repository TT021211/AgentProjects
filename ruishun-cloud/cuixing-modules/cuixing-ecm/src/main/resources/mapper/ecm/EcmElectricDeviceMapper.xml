            <if test="attr2 != null">attr2,</if>
            <if test="attr3 != null">attr3,</if>
            <if test="isMain != null">is_main,</if>
            <if test="parentId != null">parent_id,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="electricDeviceId != null">#{electricDeviceId},</if>
            <if test="electricDeviceName != null">#{electricDeviceName},</if>
            <if test="electricDeviceCode != null and electricDeviceCode != ''">#{electricDeviceCode},</if>
            <if test="model != null">#{model},</if>
            <if test="manufacturer != null">#{manufacturer},</if>
            <if test="installationDate != null">#{installationDate},</if>
            <if test="location != null">#{location},</if>
            <if test="status != null">#{status},</if>
            <if test="version != null">#{version},</if>
            <if test="isDeleted != null">#{isDeleted},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
