    </update>

    <delete id="deleteEcmElectricDeviceByElectricDeviceId" parameterType="Long">
        delete from ecm_electric_device where electric_device_id = #{electricDeviceId}
    </delete>

    <delete id="deleteEcmElectricDeviceByElectricDeviceIds" parameterType="String">
        delete from ecm_electric_device where electric_device_id in 
        <foreach item="electricDeviceId" collection="array" open="(" separator="," close=")">
            #{electricDeviceId}
        </foreach>
    </delete>

