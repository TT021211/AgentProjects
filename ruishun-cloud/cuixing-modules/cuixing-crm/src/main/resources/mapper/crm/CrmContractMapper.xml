    </select>
    <select id="selectMaxDayContractNum" resultType="java.lang.Integer" parameterType="java.util.Date">
        select max(day_contract_num)
        from crm_contract
        where DATE_FORMAT(create_time,'%Y-%m-%d') = DATE_FORMAT(#{date},'%Y-%m-%d')
    </select>
    <select id="selectCountByContractCode" resultType="java.lang.Integer"
