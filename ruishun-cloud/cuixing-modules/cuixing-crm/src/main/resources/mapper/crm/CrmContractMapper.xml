    <sql id="selectCrmContractVo">
        select contract_id,
               contract_code,
               contract_number,
               client_id,
               client_code,
               client_name,
               client_address,
               contact,
               contact_tel,
               signing_date,
               sign_location,
               delivery_date,
               delivery_location,
               payment_method,
               delivery_method,
               tax_inclusive_total_amount,
               seller_id,
               seller_name,
               contract_status,
               version,
               is_deleted,
               create_by,
               create_time,
               update_by,
               update_time,
               remark,
               attr1,
               attr2,
               attr3
        from crm_contract
    </sql>

    <select id="selectCrmContractList" parameterType="com.cuixing.crm.entity.CrmContract" resultMap="CrmContractResult">
        <include refid="selectCrmContractVo"/>
        <where>
            <if test="contractCode != null  and contractCode != ''"> and contract_code = #{contractCode}</if>
            <if test="contractNumber != null  and contractNumber != ''"> and contract_number =#{contractNumber}</if>
            <if test="clientId != null "> and client_id = #{clientId}</if>
            <if test="clientCode != null  and clientCode != ''"> and client_code =#{clientCode}</if>
            <if test="clientName != null  and clientName != ''"> and client_name like concat('%', #{clientName},'%')</if>
            <if test="clientAddress != null  and clientAddress != ''"> and client_address = #{clientAddress}</if>
            <if test="contact != null  and contact != ''"> and contact = #{contact}</if>
            <if test="contactTel != null  and contactTel != ''"> and contact_tel = #{contactTel}</if>
            <if test="signingDate != null "> and signing_date = #{signingDate}</if>
            <if test="signLocation != null  and signLocation != ''"> and sign_location = #{signLocation}</if>
            <if test="deliveryDate != null "> and delivery_date = #{deliveryDate}</if>
            <if test="deliveryLocation != null  and deliveryLocation != ''"> and delivery_location = #{deliveryLocation}</if>
            <if test="paymentMethod != null  and paymentMethod != ''"> and payment_method = #{paymentMethod}</if>
            <if test="deliveryMethod != null  and deliveryMethod != ''"> and delivery_method = #{deliveryMethod}</if>
            <if test="taxInclusiveTotalAmount != null "> and tax_inclusive_total_amount =#{taxInclusiveTotalAmount}</if>
            <if test="sellerId != null "> and seller_id = #{sellerId}</if>
            <if test="sellerName != null  and sellerName != ''"> and seller_name like concat('%', #{sellerName}, '%' )</if>
            <if test="contractStatus != null  and contractStatus != ''"> and contract_status = #{contractStatus}</if>
            <if test="version != null "> and version =#{version}</if>
            <if test="isDeleted != null "> and is_deleted = #{isDeleted}</if>
            <if test="attr1 != null  and attr1 != ''"> and attr1 = #{attr1}</if>
            <if test="attr2 != null "> and attr2 = #{attr2}</if>
            <if test="attr3 != null  and attr3 != ''"> and attr3 = #{attr3}</if>
        </where>
        order by create_time desc
    </select>

    <select id="selectCrmContractByContractId" parameterType="Long" resultMap="CrmContractResult">
        <include refid="selectCrmContractVo"/>
        where contract_id = #{contractId}
    </select>
    <select id="selectContractStatus" resultType="java.lang.String" parameterType="java.lang.Long">
        select contract_status from crm_contract where contract_id = #{contractId}
